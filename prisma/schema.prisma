datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum ItemCategoryType {
  DEVICE
  BARANG
}

enum MutationType {
  IN
  OUT
  ADJUSTMENT
}

model Category {
  id          String           @id @default(uuid())
  name        String           @unique
  type        ItemCategoryType
  codePrefix  String           @unique
  
  brands      Brand[]
  items       Item[]

  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@map("categories")
}

model Brand {
  id          String   @id @default(uuid())
  name        String
  
  categoryId  String
  category    Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  
  items       Item[]

  createdAt   DateTime @default(now())

  @@unique([name, categoryId])
  @@map("brands")
}

model Location {
  id          String     @id @default(uuid())
  name        String     @unique
  description String?
  
  items       Item[]
  stockLogs   StockLog[]

  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@map("locations")
}

model Item {
  id           String           @id @default(uuid())
  serialNumber String           @unique
  itemCode     String
  name         String
  type         ItemCategoryType
  description  String?
  status       String           @default("TERSEDIA")
  ownershipStatus String?       @default("MILIK_IT")

  categoryId   String
  category     Category         @relation(fields: [categoryId], references: [id])

  brandId      String
  brand        Brand            @relation(fields: [brandId], references: [id])

  locationId   String
  location     Location         @relation(fields: [locationId], references: [id])

  stockLogs    StockLog[]

  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@index([categoryId, brandId, locationId])
  @@index([itemCode])
  @@map("items")
}

model StockLog {
  id          String       @id @default(uuid())
  
  itemId      String
  item        Item         @relation(fields: [itemId], references: [id], onDelete: Cascade)

  locationId  String
  location    Location     @relation(fields: [locationId], references: [id])

  mutation    Int
  type        MutationType
  notes       String
  
  createdAt   DateTime     @default(now())

  @@index([itemId, createdAt])
  @@map("stock_logs")
}

model Officer {
  id        String   @id @default(uuid())
  name      String   @unique
  role      String?  @default("IT Staff")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("officers")
}

model Handover {
  id            String   @id @default(uuid())
  documentNo    String   @unique
  locationName  String   @default("PTK Shore Base Tanjung Batu")
  giverName     String
  recipientName String
  remarks       String?
  handoverDate  DateTime @default(now())
  
  items         HandoverItem[]

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("handovers")
}

model HandoverItem {
  id         String   @id @default(uuid())
  handoverId String
  handover   Handover @relation(fields: [handoverId], references: [id], onDelete: Cascade)
  
  itemId     String?
  deviceName String
  serialNo   String
  brandName  String
  recipient  String
  remarks    String?

  @@map("handover_items")
}

model AppConfig {
  id                     String   @id @default("default")
  appTitle               String   @default("IT Warehouse")
  appSubtitle            String   @default("PSTB")
  appLogo                String?
  handoverLogo           String?
  handoverTitle          String   @default("BERITA ACARA SERAH TERIMA BARANG")
  handoverLocation       String   @default("PTK Shore Base Tanjung Batu")
  primaryColor           String   @default("#b90051")
  backgroundColor        String   @default("#f8fafc")
  cardBackgroundColor    String   @default("#ffffff")
  cardBorderColor        String   @default("#e2e8f0")
  sidebarBackgroundColor String   @default("#ffffff")
  updatedAt              DateTime @updatedAt

  @@map("app_config")
}

